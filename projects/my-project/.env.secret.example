# Add KEY=value entries, then run hv sops -p <project>.
# Values are literal; shell variables and commands are not evaluated.
# The default nginx image needs no secrets. Choose names your application reads.
# Uncomment only the entries you need and replace their values locally.
# API_TOKEN=replace-with-your-own-token
# DATABASE_PASSWORD=replace-with-your-own-password
# JWT_SECRET=replace-with-your-own-signing-secret
